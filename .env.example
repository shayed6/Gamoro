# Future-Ready Browser Web Push (Optional VAPID Public Key)
VITE_VAPID_PUBLIC_KEY=""

# Backend / Cloudflare Pages Functions Service Account Secrets
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
