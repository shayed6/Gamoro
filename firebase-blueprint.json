{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile stored at /users/{uid}. Financial, points, streak, and mission counters are server-managed.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "country": { "type": "string", "enum": ["BD", "INTL"] },
        "mobile": { "type": "string", "pattern": "^\\+8801[3-9]\\d{8}$" },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "referralCode": { "type": "string", "maxLength": 50 },
        "points": { "type": "number" },
        "pointsPeriod": { "type": "string" },
        "balanceUsd": { "type": "number" },
        "streak": { "type": "number" },
        "lastClaimDate": { "type": "string" },
        "totalActiveSec": { "type": "number" },
        "totalActiveMinutes": { "type": "number" },
        "ownCode": { "type": "string" },
        "referredByMasked": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "country", "createdAt"]
    },
    "WeeklyMission": {
      "title": "WeeklyMission",
      "description": "Weekly mission progress doc at /users/{uid}/missions/{weekId}. Written only on day checkpoint or completion.",
      "type": "object",
      "properties": {
        "weekId": { "type": "string" },
        "missionId": { "type": "string" },
        "daysPlayed": { "type": "array" },
        "targetDays": { "type": "number" },
        "completed": { "type": "boolean" },
        "rewardClaimed": { "type": "boolean" },
        "rewardPoints": { "type": "number" },
        "badgeId": { "type": "string" },
        "completedAt": { "type": "string" }
      }
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "In-app notification doc at /notifications/{uid}/items/{notifId}. Read status is tracked client-side in localStorage.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["withdrawal", "streak", "mission", "referral", "system"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "refId": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "GameRatingSummary": {
      "title": "GameRatingSummary",
      "description": "Single aggregate rating document at /games/{gameId}/ratings/summary.",
      "type": "object",
      "properties": {
        "gameId": { "type": "string" },
        "upvotes": { "type": "number" },
        "ratingSum": { "type": "number" },
        "ratingCount": { "type": "number" },
        "averageRating": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    },
    "WithdrawalItem": {
      "title": "WithdrawalItem",
      "description": "Withdrawal tracker doc at /withdrawals/{withdrawalId}.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "method": { "type": "string" },
        "methodLabel": { "type": "string" },
        "label": { "type": "string" },
        "amountUsd": { "type": "number" },
        "amountBdt": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "submitted", "verifying", "approved", "sent", "paid", "rejected"] },
        "txId": { "type": "string" },
        "rejectReason": { "type": "string" },
        "submittedAt": { "type": "string" },
        "verifyingAt": { "type": "string" },
        "approvedAt": { "type": "string" },
        "sentAt": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Support ticket submitted from FAQ page at /support_tickets/{ticketId}.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "createdAt": { "type": "string" }
      }
    },
    "DailyAnalytics": {
      "title": "DailyAnalytics",
      "description": "Pre-aggregated daily stats written by scheduled worker at /analytics_daily/{YYYY-MM-DD}.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "newUsers": { "type": "number" },
        "dau": { "type": "number" },
        "mau": { "type": "number" },
        "totalPayoutsUsd": { "type": "number" },
        "pendingWithdrawalsCount": { "type": "number" },
        "pendingWithdrawalsUsd": { "type": "number" },
        "generatedAt": { "type": "string" }
      }
    },
    "SuspiciousAlert": {
      "title": "SuspiciousAlert",
      "description": "Suspicious activity alert doc at /alerts/{alertId} (admin-only).",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["multi_account_ip", "high_playtime", "rapid_withdrawal_new_account", "referral_abuse"] },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "uid": { "type": "string" },
        "userName": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "reviewed", "dismissed"] },
        "createdAt": { "type": "string" }
      }
    }
  }
}
